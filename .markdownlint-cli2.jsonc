// Markdownlint configuration for cc-review
// Single source of truth — non-pedantic, 300-column max (stack standard)
{
  // Default config as baseline (all rules enabled), then loosen the noisy ones
  "config": {
    "MD013": { "line_length": 300, "tables": false, "code_blocks": false, "headings": false },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  },

  // Ignore generated / vendored paths
  "ignores": ["node_modules/**", "dist/**", "build/**"]
}
